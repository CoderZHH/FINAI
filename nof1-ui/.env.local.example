# Core storage
POSTGRES_URL=postgresql://finai_user:finai_pass@localhost:5432/finai
POSTGRES_SSL=false
REDIS_URL=redis://localhost:6379/0

# Market + runner controls (required)
BINANCE_API_BASE=https://api.binance.com
BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_API_KEY=YOUR_BINANCE_API_KEY
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET
# Testnet (optional)
BINANCE_TESTNET=false
BINANCE_FAPI_BASE_TEST=https://testnet.binancefuture.com
BINANCE_API_KEY_TEST=
BINANCE_API_SECRET_TEST=
MARKET_LOOP_INTERVAL_MS=5000
AUTO_RUNNER_TICK_MS=5000
AUTO_RUNNER_DISABLED=false

# Optional proxy
HTTPS_PROXY=
HTTP_PROXY=
GET_MARKET_PROXY=

# Historical import window
GET_MARKET_LOOKBACK_DAYS=3
GET_MARKET_HTF_LOOKBACK_DAYS=20
GET_MARKET_START=
GET_MARKET_END=
GET_MARKET_RETRY=3

# Script helpers
ENV_FILE=.env.local
